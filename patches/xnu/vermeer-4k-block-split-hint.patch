diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1073,7 +1073,10 @@
 					/* Do not attempt to reapply the hint bit to an already-active mapping.
 					 * This very likely means we're attempting to change attributes on an already-active mapping,
 					 * which violates the requirement of the hint bit.*/
-					assert(!kva_active || (ppte[i] == ARM_PTE_EMPTY));
+					assertf(!kva_active || (ppte[i] == ARM_PTE_EMPTY),
+					    "HINTBRANCH kva=%d i=%u va=%#llx ppte=%#llx ptmp=%#llx start=%#llx end=%#llx",
+					    (int)kva_active, i, (unsigned long long)va, (unsigned long long)ppte[i],
+					    (unsigned long long)ptmp, (unsigned long long)start, (unsigned long long)_end);
 				}
 
 #if BTI_ENFORCED
@@ -1091,7 +1094,10 @@
 				 * to make sure we're not trying to unhint a sub-range of a larger hinted range, which
 				 * could produce a later TLB conflict.
 				 */
-				assert(!kva_active || (ppte[i] == ARM_PTE_EMPTY) || ((ppte[i] & ARM_PTE_HINT) == (ptmp & ARM_PTE_HINT)));
+				assertf(!kva_active || (ppte[i] == ARM_PTE_EMPTY) || ((ppte[i] & ARM_PTE_HINT) == (ptmp & ARM_PTE_HINT)),
+				    "HINTMISMATCH kva=%d i=%u va=%#llx ppte=%#llx ptmp=%#llx start=%#llx end=%#llx",
+				    (int)kva_active, i, (unsigned long long)va, (unsigned long long)ppte[i],
+				    (unsigned long long)ptmp, (unsigned long long)start, (unsigned long long)_end);
 
 				update_or_defer_tte(&ppte[i], ptmp, pa, (vm_map_address_t)ppte, granule, deferred_ttep_pair, deferred_tte_pair);
 			}
