--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -205,6 +205,101 @@
 #include <tests/xnupost.h>
 #endif
 
+#include <vm/pmap.h>
+#include <machine/machine_routines.h>
+
+/*
+ * vermeer UFS/GCC read-only probe.
+ *
+ * Reads the clock controller, the two UFS power domains and the UFS host
+ * controller without writing a single register, and prints what the firmware
+ * left behind. Booting Android from this same controller means the boot chain
+ * powered the UFS block and trained the link; if that state survives into XNU
+ * then a kernel driver can adopt the controller instead of initialising the
+ * PHY, and the PHY is the part the sheng driver's own comments mark as
+ * unqualified ("reset and RPMH/TCSR/QMP-PHY programming are not represented
+ * here; their semantics are not qualified and NativeUfs must not write them
+ * speculatively").
+ *
+ * Every offset and bit test here comes from NativeUfs::inspect (ShengUfs
+ * NativeUfs.cpp:182), which is the reference board's read-only inspection:
+ *   GDSCR bit31 is PWR_ON, CBCR bit31 is CLK_OFF and bit0 is ENABLE,
+ *   UFS CAP is 0x00, VERSION is 0x08, HCS is 0x30, HCE is 0x34, UTRLBA 0x50.
+ *
+ * Runs at the top of bsd_init, before setconf(), because setconf is what leads
+ * to IOFindBSDRoot waiting 150 seconds for a root device that cannot appear.
+ */
+static void
+vermeer_ufs_probe(void)
+{
+	const uint64_t gcc = 0x100000;      /* clock-controller@100000, 0x1f4200 */
+	const uint64_t gccMemPhy = 0x9e000; /* second UFS GDSCR window */
+	const uint64_t ufs = 0x1d84000;     /* ufshc@1d84000, 0x3000 */
+	vm_offset_t gccMap, memMap, ufsMap;
+	uint32_t gdscr, memGdscr, axi, ahb, unipro, txSym, rxSym0, phyAux, rxSym1, aggre;
+	uint32_t cap, version, is, ie, hcs, hce;
+
+	gccMap = ml_io_map(gcc, 0x1f4200);
+	memMap = ml_io_map(gccMemPhy, 0x1000);
+	ufsMap = ml_io_map(ufs, 0x3000);
+
+	if (!gccMap || !memMap || !ufsMap) {
+		kprintf("VERMEER-UFS probe: map failed gcc=%#lx mem=%#lx ufs=%#lx\n",
+		    (unsigned long)gccMap, (unsigned long)memMap, (unsigned long)ufsMap);
+		return;
+	}
+
+	/* The two power domains. bit31 is PWR_ON. */
+	gdscr    = *(volatile uint32_t *)(gccMap + 0x77004);
+	memGdscr = *(volatile uint32_t *)(memMap);
+
+	/* The CBCR branches that must be enabled for the bus to work. */
+	axi    = *(volatile uint32_t *)(gccMap + 0x77018);
+	ahb    = *(volatile uint32_t *)(gccMap + 0x77024);
+	txSym  = *(volatile uint32_t *)(gccMap + 0x77028);
+	rxSym0 = *(volatile uint32_t *)(gccMap + 0x7702c);
+	unipro = *(volatile uint32_t *)(gccMap + 0x77068);
+	phyAux = *(volatile uint32_t *)(gccMap + 0x770b0);
+	rxSym1 = *(volatile uint32_t *)(gccMap + 0x770cc);
+	aggre  = *(volatile uint32_t *)(gccMap + 0x770e4);
+
+	kprintf("VERMEER-UFS gdscr=%08x memgdscr=%08x\n", gdscr, memGdscr);
+	kprintf("VERMEER-UFS axi=%08x ahb=%08x unipro=%08x aggre=%08x\n",
+	    axi, ahb, unipro, aggre);
+	kprintf("VERMEER-UFS txsym=%08x rxsym0=%08x rxsym1=%08x phyaux=%08x\n",
+	    txSym, rxSym0, rxSym1, phyAux);
+
+	/* CAP is 0x00 and VERSION is 0x08: the other way round from the obvious
+	 * guess, and getting it backwards would have printed two plausible
+	 * numbers in the wrong fields. */
+	cap     = *(volatile uint32_t *)(ufsMap + 0x00);
+	version = *(volatile uint32_t *)(ufsMap + 0x08);
+	is      = *(volatile uint32_t *)(ufsMap + 0x20);
+	ie      = *(volatile uint32_t *)(ufsMap + 0x24);
+	hcs     = *(volatile uint32_t *)(ufsMap + 0x30);
+	hce     = *(volatile uint32_t *)(ufsMap + 0x34);
+
+	kprintf("VERMEER-UFS cap=%08x version=%08x\n", cap, version);
+	kprintf("VERMEER-UFS is=%08x ie=%08x hcs=%08x hce=%08x\n", is, ie, hcs, hce);
+
+	/* The three answers, spelled out so a photograph cannot misread them.
+	 *
+	 * powered    GDSCR bit31. Both domains should be on if the boot chain
+	 *            left the controller usable.
+	 * busclocks  the same test sheng uses: AXI not gated (CLK_OFF clear) and
+	 *            both the AXI and AHB ENABLE bits set. AHB is allowed to show
+	 *            CLK_OFF because its hwcg bit lets the branch wake on access.
+	 * version_ok a plausible UFSHCI version: the major field is 1..3 and the
+	 *            register is not all-ones, which is what an unclocked block
+	 *            reads back as. */
+	kprintf("VERMEER-UFS verdict: powered=%u mempowered=%u busclocks=%u version_ok=%u cap_nonzero=%u\n",
+	    (gdscr & 0x80000000U) ? 1 : 0,
+	    (memGdscr & 0x80000000U) ? 1 : 0,
+	    (!(axi & 0x80000000U) && (ahb & 0x1U) && (axi & 0x1U)) ? 1 : 0,
+	    (version != 0xffffffffU && ((version >> 8) & 0xff) >= 1 && ((version >> 8) & 0xff) <= 3) ? 1 : 0,
+	    (cap != 0 && cap != 0xffffffffU) ? 1 : 0);
+}
+
 void * get_user_regs(thread_t);         /* XXX kludge for <machine/thread.h> */
 void IOKitInitializeTime(void);         /* XXX */
 void IOSleep(unsigned int);             /* XXX */
@@ -570,6 +665,9 @@
 void
 bsd_init(void)
 {
+	/* vermeer: read the storage registers before anything waits on a root device. */
+	vermeer_ufs_probe();
+
 	boot_progress_stage("bsd_init enter");
 	struct uthread *ut;
 	vnode_t init_rootvnode = NULLVP;
